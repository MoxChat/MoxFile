# MoxFile default environment for direct binary deployment.
# Copy this file and replace database credentials before running in production.

MOXFILE_ADDR=:8981
MOXFILE_STORAGE_DIR=./storage
MOXFILE_DB_DSN=postgres://moxfile:change-me@127.0.0.1:5432/moxfile?sslmode=disable

MOXFILE_FILE_TTL_SECONDS=86400
MOXFILE_MAX_FILE_SIZE_BYTES=107374182400
MOXFILE_DATA_RETENTION_DAYS=30
MOXFILE_CHALLENGE_TTL_SECONDS=60
MOXFILE_AUTH_FAIL_WINDOW_MINUTES=30
MOXFILE_AUTH_FAIL_BAN_MINUTES=30
MOXFILE_AUTH_FAIL_BAN_THRESHOLD=10
